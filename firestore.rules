rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeEmployee() {
      return signedIn() && profile().data.status == 'active';
    }

    function admin() {
      return activeEmployee() && profile().data.role == 'admin';
    }

    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'alexhrnndz32@gmail.com';
    }

    function immutableFieldsUnchanged(keys) {
      return request.resource.diff(resource).unchangedKeys().hasAll(keys);
    }

    match /users/{userId} {
      // Todo empleado activo puede leer su propio perfil; solo el administrador puede listar o gestionar perfiles.
      allow get: if (signedIn() && request.auth.uid == userId) || admin();
      allow list: if admin();

      // El perfil inicial se crea únicamente a partir de una invitación pendiente y vinculada al correo autenticado.
      allow create: if (signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.role
        && request.resource.data.status == 'active')
        || (bootstrapAdmin()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active');

      // Un empleado solo puede cambiar su nombre. Rol, estado y correo se mantienen fuera de su alcance.
      allow update: if admin() || (
        signedIn()
        && request.auth.uid == userId
        && immutableFieldsUnchanged(['email', 'role', 'status', 'createdAt'])
        && request.resource.data.diff(resource).affectedKeys().hasOnly(['displayName', 'updatedAt'])
      );
      allow delete: if admin();
    }

    match /invitations/{email} {
      allow get: if admin() || (signedIn() && request.auth.token.email == email && resource.data.email == email);
      allow list: if admin();
      allow create, delete: if admin();
      allow update: if admin() || (
        signedIn()
        && request.auth.token.email == email
        && resource.data.status == 'pending'
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.role == resource.data.role
        && request.resource.data.invitedBy == resource.data.invitedBy
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
      );
    }

    // Los módulos operativos son accesibles solo a empleados activos. Las reglas se evalúan
    // para cada lectura/escritura, incluso si alguien intenta saltarse la interfaz.
    match /customers/{customerId} {
      allow read, create, update, delete: if activeEmployee();
    }

    match /reservations/{reservationId} {
      allow read, create, update, delete: if activeEmployee();
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if activeEmployee();
    }

    match /tasks/{taskId} {
      // Administración/IT coordina el trabajo. El Personal solo puede actualizar el estado de tareas propias.
      allow read: if activeEmployee();
      allow create: if admin() && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() || (activeEmployee()
        && resource.data.assignedToId == request.auth.uid
        && request.resource.data.diff(resource).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'updatedByName']));
      allow delete: if admin();
    }

    match /incidents/{incidentId} {
      // Cualquier integrante activo puede reportar una incidencia propia; la gestión y cierre son administrativos.
      allow read: if activeEmployee();
      allow create: if activeEmployee() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if admin();
    }

    match /expenses/{expenseId} {
      // Los gastos alteran la lectura financiera: únicamente Administración/IT puede consultarlos y gestionarlos.
      allow read, create, update: if admin();
      allow delete: if false;
    }

    // ---- Recursos Humanos: expediente y datos laborales con privacidad por titular. ----
    match /hrProfiles/{employeeId} {
      allow get: if admin() || (activeEmployee() && employeeId == request.auth.uid);
      allow list: if admin();
      allow create: if admin() || (activeEmployee()
        && employeeId == request.auth.uid
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.keys().hasOnly(['employeeId', 'personalEmail', 'personalPhone', 'address', 'emergencyContactName', 'emergencyContactPhone', 'createdAt', 'updatedAt', 'createdBy', 'createdByName', 'createdByEmail']));
      allow update: if admin() || (activeEmployee()
        && employeeId == request.auth.uid
        && request.resource.data.diff(resource).affectedKeys().hasOnly(['personalEmail', 'personalPhone', 'address', 'emergencyContactName', 'emergencyContactPhone', 'updatedAt']));
      allow delete: if admin();
    }

    match /organizationUnits/{unitId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /workSchedules/{scheduleId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    // Contratos y referencias documentales contienen información laboral sensible: solo Administración/IT.
    match /employmentContracts/{contractId} {
      allow read, create, update, delete: if admin();
    }

    match /hrDocuments/{documentId} {
      allow read, create, update, delete: if admin();
    }

    match /lifecycleChecklists/{checklistId} {
      allow read, create, update, delete: if admin();
    }

    match /attendanceRecords/{recordId} {
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /leaveRequests/{requestId} {
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update, delete: if admin();
    }

    // Desarrollo: cada persona consulta únicamente sus resultados y formación; Administración/IT los gestiona.
    match /hrGoals/{goalId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /performanceReviews/{reviewId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /trainingRecords/{trainingId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /recognitions/{recognitionId} {
      allow get, list: if admin() || (activeEmployee() && (resource.data.visibility == 'company' || resource.data.employeeId == request.auth.uid));
      allow create, update, delete: if admin();
    }

    match /hrPolicies/{policyId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.active == true);
      allow create, update, delete: if admin();
    }

    match /policyAcknowledgments/{acknowledgmentId} {
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update, delete: if false;
    }

    match /products/{productId} {
      // El catálogo es visible para todo el Personal; solo Administración/IT lo administra.
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /accessLogs/{accessId} {
      // Cada integrante registra únicamente su propio acceso; la consulta es administrativa.
      allow create: if activeEmployee()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if admin();
      allow update, delete: if false;
    }

    match /carbonUsage/{usageId} {
      // Son estimaciones informativas del navegador. Cada integrante solo puede crear y consultar las suyas;
      // Administración/IT puede revisar el consolidado, sin alterar el historial ambiental.
      allow create: if activeEmployee()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /securitySettings/{settingId} {
      // Toda persona activa puede leer la política vigente; solo Administración/IT la modifica.
      allow read: if activeEmployee();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /activityLogs/{activityId} {
      // Toda escritura de un movimiento debe identificar al empleado autenticado.
      allow create: if activeEmployee()
        && request.resource.data.actorId == request.auth.uid;
      allow get, list: if admin();
      allow update: if false;
      allow delete: if admin();
    }

    match /generalReminders/{reminderId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /sequences/{category} {
      allow read: if activeEmployee();
      allow create: if activeEmployee()
        && request.resource.data.current == 1;
      allow update: if activeEmployee()
        && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
