rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeEmployee() {
      return signedIn() && profile().data.status == 'active';
    }

    // Departamento de IT: control total de identidad, seguridad y auditoría.
    function it() {
      return activeEmployee() && profile().data.role == 'it';
    }

    // Administración opera los módulos esenciales; IT hereda estos permisos.
    function admin() {
      return activeEmployee() && (profile().data.role == 'admin' || profile().data.role == 'it');
    }

    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'alexhrnndz32@gmail.com';
    }

    function immutableFieldsUnchanged(keys) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(keys);
    }

    function validTemporaryPermission(module, scope, recordId, action) {
      let permissionId = request.auth.uid + '__' + module + '__' + (scope == 'record' ? recordId : scope);
      return exists(/databases/$(database)/documents/temporaryPermissions/$(permissionId))
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.module == module
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.scope == scope
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.status == 'active'
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/temporaryPermissions/$(permissionId)).data.actions.hasAny([action]);
    }

    function temporaryModulePermission(module, recordId, action) {
      return validTemporaryPermission(module, 'record', recordId, action)
        || validTemporaryPermission(module, 'module', recordId, action);
    }

    /** Un pago confirmado solo cambia como parte del dictamen administrativo que referencia. */
    function paymentCurrencyMatchesReservation() {
      return !request.resource.data.keys().hasAny(['reservationId'])
        || request.resource.data.reservationId == ''
        || (exists(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
          && request.resource.data.currency == get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.currency);
    }

    function approvedPaymentAdjustment(paymentId) {
      let adjustmentId = request.resource.data.lastAdjustmentRequestId;
      let adjustmentPath = /databases/$(database)/documents/paymentAdjustmentRequests/$(adjustmentId);
      let adjustment = getAfter(adjustmentPath).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return admin()
        && adjustment.paymentId == paymentId
        && adjustment.status == 'approved'
        && adjustment.decidedBy == request.auth.uid
        && changed.hasOnly(['amount', 'kind', 'currency', 'method', 'status', 'paidAt', 'notes', 'lastAdjustmentRequestId', 'updatedBy', 'updatedByName', 'updatedAt'])
        && request.resource.data.lastAdjustmentRequestId == adjustmentId
        && request.resource.data.updatedBy == request.auth.uid
        && (!changed.hasAny(['amount']) || (adjustment.proposedChanges.keys().hasAny(['amount']) && request.resource.data.amount == adjustment.proposedChanges.amount))
        && (!changed.hasAny(['kind']) || (adjustment.proposedChanges.keys().hasAny(['kind']) && request.resource.data.kind == adjustment.proposedChanges.kind))
        && (!changed.hasAny(['currency']) || (adjustment.proposedChanges.keys().hasAny(['currency']) && request.resource.data.currency == adjustment.proposedChanges.currency))
        && (!changed.hasAny(['method']) || (adjustment.proposedChanges.keys().hasAny(['method']) && request.resource.data.method == adjustment.proposedChanges.method))
        && (!changed.hasAny(['status']) || (adjustment.proposedChanges.keys().hasAny(['status']) && request.resource.data.status == adjustment.proposedChanges.status))
        && (!changed.hasAny(['paidAt']) || (adjustment.proposedChanges.keys().hasAny(['paidAt']) && request.resource.data.paidAt == adjustment.proposedChanges.paidAt))
        && (!changed.hasAny(['notes']) || (adjustment.proposedChanges.keys().hasAny(['notes']) && request.resource.data.notes == adjustment.proposedChanges.notes));
    }

    match /users/{userId} {
      // El directorio mínimo permite coordinar guardias, asignaciones y comunicaciones internas.
      // La gestión de roles, estados e identidad permanece reservada al Departamento de IT.
      allow get: if activeEmployee() || (bootstrapAdmin() && request.auth.uid == userId);
      allow list: if activeEmployee();

      // El perfil inicial se crea únicamente a partir de una invitación pendiente y vinculada al correo autenticado.
      allow create: if (signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.role
        && request.resource.data.status == 'active')
        || (bootstrapAdmin()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'it'
          && request.resource.data.status == 'active');

      // Departamento de IT administra perfiles que aún no son IT; los perfiles IT no se alteran entre sí.
      // Administración puede actualizar información operativa de Personal, sin cambiar rol ni estado.
      allow update: if (it() && resource.data.role != 'it') || (admin()
        && profile().data.role == 'admin'
        && resource.data.role == 'personal'
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])) || (bootstrapAdmin()
        && request.auth.uid == userId
        && request.resource.data.role == 'it'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])) || (
        signedIn()
        && request.auth.uid == userId
        && immutableFieldsUnchanged(['email', 'role', 'status', 'createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
      );
      allow delete: if it() && resource.data.role != 'it';
    }

    match /invitations/{email} {
      allow get: if it() || (signedIn() && request.auth.token.email == email && resource.data.email == email);
      allow list: if it();
      allow create: if it() || (admin() && profile().data.role == 'admin' && request.resource.data.role == 'personal');
      allow delete: if it() && resource.data.role != 'it';
      allow update: if (it() && resource.data.role != 'it') || (admin()
        && profile().data.role == 'admin'
        && resource.data.role == 'personal'
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])) || (
        signedIn()
        && request.auth.token.email == email
        && resource.data.status == 'pending'
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.role == resource.data.role
        && request.resource.data.invitedBy == resource.data.invitedBy
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
      );
    }

    // Los módulos operativos son accesibles solo a empleados activos. Las reglas se evalúan
    // para cada lectura/escritura, incluso si alguien intenta saltarse la interfaz.
    match /customers/{customerId} {
    allow read, create, update: if activeEmployee();
      allow delete: if admin();
    }

    match /reservations/{reservationId} {
      allow read, create, update: if activeEmployee();
      allow delete: if admin();
    }

    match /payments/{paymentId} {
      allow read: if activeEmployee();
      allow create: if activeEmployee()
        && request.resource.data.amount > 0
        && paymentCurrencyMatchesReservation();
      allow delete: if admin();
      // Un pago confirmado permanece inmutable; sus correcciones se solicitan y aprueban por separado.
      allow update: if activeEmployee()
        && request.resource.data.amount > 0
        && paymentCurrencyMatchesReservation()
        && (resource.data.status != "paid" || approvedPaymentAdjustment(paymentId));
    }

    match /paymentAdjustmentRequests/{requestId} {
      allow read: if activeEmployee();
      allow create: if activeEmployee() && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if admin();
    }

    match /tasks/{taskId} {
      // Administración/IT coordina el trabajo. El Personal solo puede actualizar el estado de tareas propias.
      allow read: if activeEmployee();
      allow create: if admin() && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() || (activeEmployee()
        && resource.data.assignedToId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'updatedByName']));
      allow delete: if admin();
    }

    match /incidents/{incidentId} {
      // Cualquier integrante activo puede reportar una incidencia propia; la gestión y cierre son administrativos.
      allow read: if activeEmployee();
      allow create: if activeEmployee() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if admin();
    }

    match /expenses/{expenseId} {
      // Los gastos alteran la lectura financiera: únicamente Administración/IT puede consultarlos y gestionarlos.
      allow read, create, update: if admin();
      allow delete: if false;
    }

    // ---- Recursos Humanos: expediente y datos laborales con privacidad por titular. ----
    match /hrProfiles/{employeeId} {
      allow get: if admin() || (activeEmployee() && employeeId == request.auth.uid);
      allow list: if admin();
      allow create: if admin() || (activeEmployee()
        && employeeId == request.auth.uid
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.keys().hasOnly(['employeeId', 'personalEmail', 'personalPhone', 'address', 'emergencyContactName', 'emergencyContactPhone', 'createdAt', 'updatedAt', 'createdBy', 'createdByName', 'createdByEmail']));
      allow update: if admin() || (activeEmployee()
        && employeeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personalEmail', 'personalPhone', 'address', 'emergencyContactName', 'emergencyContactPhone', 'updatedAt']));
      allow update: if activeEmployee()
        && employeeId == request.auth.uid
        && (validTemporaryPermission('hr', 'self', employeeId, 'edit') || validTemporaryPermission('hr', 'record', employeeId, 'edit'));
      allow delete: if admin();
    }

    match /organizationUnits/{unitId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /workSchedules/{scheduleId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    // Contratos y referencias documentales contienen información laboral sensible: solo Administración/IT.
    match /employmentContracts/{contractId} {
      allow read, create, update, delete: if admin();
    }

    match /hrDocuments/{documentId} {
      allow read, create, update, delete: if admin();
    }

    match /lifecycleChecklists/{checklistId} {
      allow read, create, update, delete: if admin();
    }

    match /attendanceRecords/{recordId} {
      // Personal crea sus propias marcaciones; Administración/IT puede registrar o corregir cualquier caso excepcional.
      allow create: if admin() || (activeEmployee() && request.resource.data.employeeId == request.auth.uid) || (activeEmployee()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['guardWeekKey'])
        && exists(/databases/$(database)/documents/attendanceGuards/$(request.resource.data.guardWeekKey))
        && get(/databases/$(database)/documents/attendanceGuards/$(request.resource.data.guardWeekKey)).data.guardUserId == request.auth.uid);
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /attendanceGuards/{weekKey} {
      // La guardia se consulta para operar la asistencia; Administración/IT asigna o reasigna la rotación.
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /updateRequests/{requestId} {
      // Administración/IT asigna y controla; cada persona consulta y marca completadas solo sus propias solicitudes.
      allow get, list: if admin() || (activeEmployee() && resource.data.targetUserId == request.auth.uid);
      allow create, delete: if admin();
      allow update: if admin() || (activeEmployee()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedBy == request.auth.uid);
    }

    match /automations/{automationId} {
      // Las automatizaciones son visibles a personal autorizado y solo Administración/IT las administra.
      allow read: if admin();
      allow create, update, delete: if admin();
    }

    match /attendanceCounters/{counterId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid && request.resource.data.count == 1;
      allow update: if activeEmployee() && resource.data.employeeId == request.auth.uid
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.type == resource.data.type
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /attendanceSettings/{settingId} {
      allow read: if activeEmployee();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /leaveRequests/{requestId} {
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update, delete: if admin();
    }

    // Desarrollo: cada persona consulta únicamente sus resultados y formación; Administración/IT los gestiona.
    match /hrGoals/{goalId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /performanceReviews/{reviewId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /trainingRecords/{trainingId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /recognitions/{recognitionId} {
      allow get, list: if admin() || (activeEmployee() && (resource.data.visibility == 'company' || resource.data.employeeId == request.auth.uid));
      allow create, update, delete: if admin();
    }

    match /hrPolicies/{policyId} {
      allow get, list: if admin() || (activeEmployee() && resource.data.active == true);
      allow create, update, delete: if admin();
    }

    match /payrollRuns/{payrollId} {
      // La planilla contiene salarios, deducciones y pagos: acceso exclusivo administrativo.
      allow read, create, update: if admin();
      allow delete: if false;
    }

    match /policyAcknowledgments/{acknowledgmentId} {
      allow create: if activeEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.employeeId == request.auth.uid);
      allow update: if activeEmployee()
        && resource.data.employeeId == request.auth.uid
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.policyId == resource.data.policyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'acknowledgedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      // El catálogo es visible para todo el Personal; solo Administración/IT lo administra.
      allow read: if activeEmployee();
      allow create: if admin();
      allow update: if admin() || (activeEmployee() && temporaryModulePermission('products', productId, 'edit'));
      allow delete: if admin() || (activeEmployee() && temporaryModulePermission('products', productId, 'delete'));
    }

    match /productCategorySettings/{categoryId} {
      // La etiqueta es pública dentro de SIGES; su configuración queda reservada a Administración/IT.
      allow read: if activeEmployee();
      allow create, update: if admin()
        && categoryId in ['tariff', 'promotion']
        && request.resource.data.id == categoryId
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80;
      allow delete: if admin();
    }

    match /temporaryPermissions/{permissionId} {
      // Administración/IT administra permisos; Personal solo puede revocar el suyo al completar la solicitud asociada.
      allow get, list: if admin() || (activeEmployee() && resource.data.userId == request.auth.uid);
      allow create, delete: if admin();
      allow update: if admin() || (activeEmployee()
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/updateRequests/$(resource.data.requestId)).data.status == 'completed');
    }

    match /internalMessages/{messageId} {
      // Correo estrictamente interno: emisor, destinatarios y supervisores autorizados.
      allow create: if activeEmployee()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.recipientIds.size() > 0;
      allow get, list: if admin() || (activeEmployee() && resource.data.participantIds.hasAny([request.auth.uid]));
      allow update: if admin() || (activeEmployee()
        && resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByIds', 'updatedAt']))
        || (activeEmployee()
          && resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trashedByIds', 'deletedByIds', 'updatedAt']))
        || (activeEmployee()
          && resource.data.senderId == request.auth.uid
          && resource.data.status == 'scheduled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scheduledFor', 'updatedAt']))
        || (activeEmployee()
          && resource.data.senderId == request.auth.uid
          && (resource.data.status == 'draft' || resource.data.status == 'scheduled')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientIds', 'participantIds', 'subject', 'body', 'status', 'scheduledFor', 'sentAt', 'updatedAt']));
      allow delete: if admin() || (activeEmployee() && resource.data.senderId == request.auth.uid && (resource.data.status == 'draft' || resource.data.status == 'scheduled'));
    }

    match /accessLogs/{accessId} {
      // Cada integrante registra únicamente su propio acceso; la consulta es administrativa.
      allow create: if activeEmployee()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if it();
      allow update, delete: if false;
    }

    match /carbonUsage/{usageId} {
      // Son estimaciones informativas del navegador. Cada integrante solo puede crear y consultar las suyas;
      // Administración/IT puede revisar el consolidado, sin alterar el historial ambiental.
      allow create: if activeEmployee()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if admin() || (activeEmployee() && resource.data.userId == request.auth.uid);
      allow update: if activeEmployee() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeMilliseconds', 'operationCount', 'pageViews', 'departmentId', 'departmentName', 'sessionEndedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /securitySettings/{settingId} {
      // Toda persona activa puede leer la política vigente; solo IT la modifica.
      allow read: if activeEmployee();
      allow create, update: if it();
      allow delete: if false;
    }

    match /activityLogs/{activityId} {
      // Toda escritura de un movimiento debe identificar al empleado autenticado.
      allow create: if activeEmployee()
        && request.resource.data.actorId == request.auth.uid;
      allow get, list: if admin();
      allow update: if false;
      allow delete: if false;
    }

    match /generalReminders/{reminderId} {
      allow read: if activeEmployee();
      allow create, update, delete: if admin();
    }

    match /sequences/{category} {
      allow read: if activeEmployee();
      allow create: if activeEmployee()
        && request.resource.data.current == 1;
      allow update: if activeEmployee()
        && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
