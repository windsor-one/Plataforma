rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function message(messageId) {
      return firestore.get(/databases/(default)/documents/internalMessages/$(messageId));
    }

    function participant(messageId) {
      return signedIn() && message(messageId).data.participantIds.hasAny([request.auth.uid]);
    }

    match /internalMessages/{messageId}/{fileName} {
      allow read: if participant(messageId);
      allow create: if signedIn()
        && message(messageId).data.senderId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if signedIn() && message(messageId).data.senderId == request.auth.uid;
      allow update: if false;
    }
  }
}
